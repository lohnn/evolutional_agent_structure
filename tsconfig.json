{
  // The root owns no TypeScript since the 2026-11-27 OpenCode retirement —
  // ROOT-SURFACE.d.ts is an intentionally empty ambient marker (see its header).
  // Real TS/test gates are per-package inside dsh-hive/. TS 6 rejects empty
  // include/files lists (TS18002/TS18003), hence the marker below.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["ROOT-SURFACE.d.ts"],
  "exclude": ["node_modules", "dist", "dsh-hive", "dsh-hive-dist"]
}
